{
  "name": "jsx-middlewares",
  "version": "3.0.0",
  "type": "module",
  "description": "Transform rendered JSX with middlewares",
  "homepage": "https://gkurt.com/jsx-middlewares/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/jsx-middlewares.git",
    "directory": "packages/jsx-middlewares"
  },
  "bugs": {
    "url": "https://github.com/gkurt/jsx-middlewares/issues"
  },
  "keywords": [
    "jsx",
    "react",
    "middleware",
    "decorator",
    "directive"
  ],
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://github.com/gkurt"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "jsx-middlewares@dev": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "source": "./src/index.ts"
    },
    "./react": {
      "jsx-middlewares@dev": "./src/react/index.ts",
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "source": "./src/react/index.ts"
    },
    "./react/jsx-runtime": {
      "jsx-middlewares@dev": "./src/react/jsx-runtime.ts",
      "import": {
        "types": "./dist/react/jsx-runtime.d.mts",
        "default": "./dist/react/jsx-runtime.mjs"
      },
      "source": "./src/react/jsx-runtime.ts"
    },
    "./react/jsx-dev-runtime": {
      "jsx-middlewares@dev": "./src/react/jsx-dev-runtime.ts",
      "import": {
        "types": "./dist/react/jsx-dev-runtime.d.mts",
        "default": "./dist/react/jsx-dev-runtime.mjs"
      },
      "source": "./src/react/jsx-dev-runtime.ts"
    }
  },
  "imports": {
    "#*": "./*",
    "#test-runtime/jsx-dev-runtime": "./tests/jsx-dev-runtime.ts"
  },
  "scripts": {
    "start": "tsdown --watch",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "bun test --conditions=jsx-middlewares@dev --preload ./tests/preload.ts",
    "prepack": "bun run build",
    "attw": "bunx --bun @arethetypeswrong/cli --pack . --profile esm-only",
    "publint": "bunx --bun publint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "publint": "^0.3.23",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
