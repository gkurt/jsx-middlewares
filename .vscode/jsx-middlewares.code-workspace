{
  "folders": [
    {
      "name": "🌴 Root",
      "path": ".."
    },
    {
      "name": "📦 jsx-middlewares",
      "path": "../packages/jsx-middlewares"
    },
    {
      "name": "🌐 Website",
      "path": "../website"
    },
    {
      "name": "🌩️ Vite Example",
      "path": "../examples/vite"
    }
  ],
  "settings": {
    "files.exclude": {
      "packages": true,
      "website": true,
      "examples": true
    },
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.fixAll.biome": "explicit"
    },
    "[js][jsx][ts][tsx][typescript][typescriptreact][javascript][javascriptreact][json][jsonc][html][css][scss][markdown][mdx]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "editor.formatOnSave": true,
    "workbench.editor.labelFormat": "medium",
    "js/ts.experimental.useTsgo": true,
    "js/ts.preferences.quoteStyle": "single",
    "js/ts.tsdk.path": "🌴 Root/node_modules/typescript/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "bun.test.enable": true
  }
}
