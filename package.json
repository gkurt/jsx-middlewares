{
  "name": "@jsx-middlewares/root",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Monorepo root for jsx-middlewares",
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://github.com/gkurt"
  },
  "scripts": {
    "start": "bun --filter=jsx-middlewares run start",
    "dev": "bun --filter=jsx-middlewares run dev",
    "build": "bun --filter=jsx-middlewares run build",
    "typecheck": "tsc && bun --filter=jsx-middlewares run typecheck",
    "typecheck:website": "bun run --cwd website typecheck",
    "test": "bun --filter=jsx-middlewares run test",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "fix": "biome check --write",
    "checks": "bun check && bun typecheck && bun run test",
    "attw": "bun --filter=jsx-middlewares run attw",
    "publint": "bun --filter=jsx-middlewares run publint",
    "prepare": "husky",
    "tegami": "bun scripts/tegami.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tegami": "^1.3.5",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ]
}
